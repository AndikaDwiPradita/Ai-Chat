# Salin file ini menjadi .env dan isi nilainya.
#   cp .env.example .env

# Wajib untuk fitur AI berbasis OrcaRouter (lihat https://api.orcarouter.ai).
ORCAROUTER_API_KEY=your-orcarouter-api-key

# Opsional — Ollama lokal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=true

# Opsional — generator gambar/video (lihat backend/media_api.py).
IMAGE_API_PROVIDER=pollinations
IMAGE_MODEL=
POLLINATIONS_TOKEN=
HF_TOKEN=
HUGGINGFACE_API_KEY=
IMAGE_GEN_API_KEY=
VIDEO_GEN_API_KEY=
VIDEO_MODEL=

# Opsional — server.
HOST=127.0.0.1
PORT=5000
